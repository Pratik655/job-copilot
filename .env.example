# Apinex AI Configuration (Free GPT-Luna, Rate limit: 5 req/min)
APINEX_API_KEY=your_apinex_api_key_here
APINEX_MODEL=free/gpt-6-luna
APINEX_BASE_URL=https://api.apinex.bond/v1

# Optional fallback: OpenAI API
OPENAI_API_KEY=
